PORT=3003
# Express 'trust proxy' (default loopback). "false" when nothing proxies the server; otherwise a
# local client can spoof X-Forwarded-For past the rate limits. Behind nginx use $proxy_add_x_forwarded_for.
TRUST_PROXY=loopback
# 1 = always set the Secure cookie flag (TLS terminated by a non-loopback proxy / load balancer).
SECURE_COOKIES=0

# ─── Solana ───────────────────────────────────────────────────────────────────
# devnet | mainnet. Selects the IDL (devnet uses the layout-compat IDL) and the
# error-code table. Program id and mint default to the devnet deployment.
SOLANA_NETWORK=devnet
# Comma-separated RPC pool, first = preferred. Put a dedicated endpoint
# (Helius etc.) first; the public devnet RPC rate-limits getProgramAccounts.
SOLANA_RPC_URLS=https://api.devnet.solana.com
# Bind address (default 127.0.0.1; set 0.0.0.0 only behind a firewall or reverse proxy) and where
# state files live (nodes-cache.json, privy-wallets.json, .session-key; default = repo root).
# HOST=0.0.0.0
# DATA_DIR=/var/lib/plans-solana
# 32-byte hex key for the session cookies; generated into DATA_DIR/.session-key when unset.
# SESSION_KEY=
# Extra origins allowed to POST (comma-separated) when the UI is served from another host.
# ALLOWED_ORIGINS=
DVPN_PROGRAM_ID=J52dyXW3a6mkatvrQct3fo6dA9vqUtcsdBt5gGqrTBXs
DVPN_MINT=Hen2LVP6KooGaXEvdSyCHWghsEY4gLLn7wix8z6zHFSa

# ─── Provider daemon(s) ───────────────────────────────────────────────────────
# Node linking (roster) and lease keeping live in the provider dvpnd daemon,
# reached over its gRPC control socket. One entry per provider PDA:
#   <providerPda>=unix:///root/dvpnd-provider/daemon.sock
#   <providerPda>=127.0.0.1:50052        (dev bridge, see scripts/dev/)
DVPND_PROVIDER_SOCKETS=
# Optional: where the console reaches the provider's HTTPS API when the on-chain
# uri is not routable from here (dev bridge): <providerPda>=https://127.0.0.1:19443
DVPND_PROVIDER_APIS=

# ─── Privy embedded-wallet login (optional) ───────────────────────────────────
# The Privy app must have Solana embedded wallets enabled.
PRIVY_APP_ID=
PRIVY_APP_SECRET=
PRIVY_CLIENT_ID=

# Devnet test wallet (funded, see memory/handoff-plans-solana.md). Never commit the file it points to.
TEST_KEYFILE=
